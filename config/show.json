{
  "show_name": "X射线无损检测与AI图像处理前沿",
  "subtitle": "中文科技播客 · X-ray/CT 无损检测 · 半导体 TSV/TGV 检测 · AI 图像处理 · 科研与工业应用",
  "language": "zh-CN",
  "timezone": "America/Toronto",
  "pages_url": "https://caozixiong.github.io/ai-podcast/",
  "base_path": "/ai-podcast/",
  "episode": {
    "min_items": 2,
    "max_items": 6,
    "max_headline_items": 2,
    "min_substantive_items": 1,
    "min_relevance": 4,
    "_min_relevance_note": "相关度下限：低于它的素材不入选，不够条数就少播或跳过，不拿不相干的内容凑数。打分规则见 sources.json 的 _scoring。",
    "lookback_days": 30,
    "news_lookback_days": 10,
    "target_duration_min": 5,
    "target_duration_max": 10
  },
  "llm": {
    "provider": "ollama",
    "model": "qwen3.8:27b",
    "fallback_model": "qwen3.6:27b",
    "base_url": "http://127.0.0.1:11434",
    "temperature": 0.3,
    "max_tokens": 2000,
    "timeout_s": 240,
    "_gemini_alternative": {
      "provider": "google_ai_studio",
      "model": "gemini-2.5-flash",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key_env": "GEMINI_API_KEY",
      "note": "本机环境 Gemini 生成接口 404，默认走本地 Ollama（免费）；换到能访问 Gemini 的机器可改用此配置。"
    }
  },
  "quality": {
    "on_violation": "block",
    "_note": "口播稿程序自检不通过（自动改写一次后仍有问题）时：block=拒绝发布；warn=照常发布，只记录问题"
  },
  "tts": {
    "engine": "edge-tts",
    "voice": "zh-CN-YunxiNeural",
    "alt_voices": ["zh-CN-XiaoxiaoNeural", "zh-CN-YunyangNeural"],
    "rate": "+0%",
    "min_duration_sec": 10,
    "max_duration_sec": 1500
  },
  "drive": {
    "rclone_remote": "podcastdrive",
    "remote_path": "PodcastPublisher/audio",
    "private_backup_remote": "podcastdrive",
    "private_backup_path": "PodcastPublisher/private-backup",
    "separate_public_from_private": true
  }
}
