# ===== Google AI Studio / Gemini（撰稿 LLM）=====
# 从 https://aistudio.google.com/app/apikey 获取；填真实值后请勿提交本文件
GEMINI_API_KEY=
# 可选：覆盖 OpenAI 兼容端点（默认 Google 的）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ===== 中文 TTS（edge-tts）=====
# 可选：指定音色（默认见 config/show.json 的 tts.voice）
# EDGE_TTS_VOICE=zh-CN-YunxiNeural

# ===== Google Drive（rclone remote）=====
# rclone 的凭据存在 rclone 自己的配置里（~/.config/rclone/rclone.conf），
# 不要放在这里。remote 名称见 config/show.json 的 drive.rclone_remote。
